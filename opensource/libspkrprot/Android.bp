cc_defaults {
    name: "sweet_oss_spkrprot_defaults",
    cflags: ["-Werror"],
    include_dirs: [
        "external/tinyalsa/include",
        "external/tinycompress/include",
        "hardware/qcom-caf/sm8150/audio/hal",
        "hardware/qcom-caf/sm8150/audio/hal/msm8974",
        "system/media/audio_route/include",
        "system/media/audio_utils/include",
    ],
    header_libs: [
        "libhardware_headers",
        "qti_kernel_headers",
    ],
    shared_libs: [
        "libcutils",
        "liblog",
    ],
    sanitize: {
        integer_overflow: true,
    },
}

cc_library_shared {
    name: "libspkrprot_sweet",
    stem: "libspkrprot",
    owner: "third_party",
    defaults: ["sweet_oss_spkrprot_defaults"],
    vendor: true,
    srcs: ["spkr_protection.c"],
    cflags: ["-DSPKR_PROT_ENABLED"],
    shared_libs: [
        "libaudioroute",
        "libtinyalsa",
    ],
    compile_multilib: "32",
    soc_specific: true,
}
